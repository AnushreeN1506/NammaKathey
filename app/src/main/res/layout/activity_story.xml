<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <!-- HERO NAME -->
            <TextView
                android:id="@+id/heroNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hero Name"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/languageToggle"/>

            <!-- LANGUAGE TOGGLE -->
            <Button
                android:id="@+id/languageToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN | KN"
                android:textSize="12sp"
                android:backgroundTint="#475569"
                android:textColor="#FFFFFF"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"/>

        </RelativeLayout>

        <!-- SUMMARY CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/premium_card"
            android:padding="20dp"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/summaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hero Summary"
                android:textSize="17sp"
                android:textStyle="italic"
                android:textColor="#CBD5E1"
                android:lineSpacingExtra="5dp"/>
        </LinearLayout>

        <!-- PAGE NUMBER -->

        <TextView
            android:id="@+id/pageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chapter 1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FBBF24"
            android:layout_marginTop="30dp"/>

        <!-- STORY TITLE -->

        <TextView
            android:id="@+id/storyTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Story Title"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="22dp"/>

        <!-- STORY CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/premium_card"
            android:padding="24dp">

            <TextView
                android:id="@+id/storyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Story"
                android:textSize="19sp"
                android:textColor="#E2E8F0"
                android:lineSpacingExtra="12dp"/>
        </LinearLayout>

        <!-- NAVIGATION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="30dp">

            <Button
                android:id="@+id/previousButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⬅ Previous"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:backgroundTint="#475569"
                android:textColor="#FFFFFF"/>

            <Space
                android:layout_width="20dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/nextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next ➡"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- ACTION BUTTONS -->

        <Button
            android:id="@+id/listenButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="🔊 Listen Narration"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="17sp"
            android:backgroundTint="#1D4ED8"
            android:textColor="#FFFFFF"
            android:layout_marginTop="34dp"/>

        <Button
            android:id="@+id/quizButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="🧠 Start Hero Quiz"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="17sp"
            android:backgroundTint="#F59E0B"
            android:textColor="#FFFFFF"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="40dp"/>

    </LinearLayout>

</ScrollView>