<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/premium_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <!-- APP TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Namma-Kathey"
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Continue your heritage journey"
            android:textSize="18sp"
            android:textColor="#CBD5E1"
            android:layout_marginTop="12dp"/>

        <!-- LOGIN CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/premium_card"
            android:padding="24dp"
            android:layout_marginTop="40dp">

            <!-- EMAIL -->

            <EditText
                android:id="@+id/emailEditText"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:hint="Email"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:background="@drawable/option_card_default"
                android:inputType="textEmailAddress"/>

            <!-- PASSWORD -->

            <EditText
                android:id="@+id/passwordEditText"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:hint="Password"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:background="@drawable/option_card_default"
                android:layout_marginTop="18dp"
                android:inputType="textPassword"/>

            <!-- LOGIN BUTTON -->

            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="Sign In"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB"
                android:layout_marginTop="28dp"/>

            <!-- CREATE ACCOUNT -->

            <Button
                android:id="@+id/signupButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="Create Account"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0F172A"
                android:layout_marginTop="16dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>